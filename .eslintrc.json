{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "react",
    "@typescript-eslint",
    "prettier",
    "unused-imports" // Плагин для автоматического удаления неиспользуемых импортов
  ],
  "rules": {
    /* PRETTIER (Форматирование) */
    "prettier/prettier": ["error", { "endOfLine": "auto" }],

    /* REACT */
    "react/react-in-jsx-scope": "off", // Не требует импорт React в каждом файле (для новых версий)
    "react/prop-types": "off", // Отключает проверку типов через prop-types (юзаем TS)

    /* TYPESCRIPT */
    "@typescript-eslint/no-explicit-any": "off", // Разрешает использовать тип any

    /* УДАЛЕНИЕ НЕИСПОЛЬЗУЕМОГО (АВТОСЕЙВ) */
    "@typescript-eslint/no-unused-vars": "off", // Отключаем стандартное правило, чтобы не конфликтовать с плагином
    "unused-imports/no-unused-imports": "error", // Основное правило: удаляет импорты при сохранении
    "unused-imports/no-unused-vars": [
      "warn", // Подсвечивает неиспользуемые переменные (но не удаляет их сам, только импорты)
      {
        "vars": "all",
        "varsIgnorePattern": "^_",
        "args": "after-used",
        "argsIgnorePattern": "^_"
      }
    ],

    /* ПРАВИЛА-ПОМОЩНИКИ */
    "prefer-const": "error", // Автоматически меняет let на const, если значение не перезаписывается
    "eqeqeq": ["error", "always"], // Требует строгое сравнение (=== вместо ==)
    "curly": "error", // Требует фигурные скобки для всех блоков (if, else, for)
    "no-var": "error", // Запрещает использование var (только let/const)
    "react-hooks/exhaustive-deps": "warn" // Проверяет зависимости в useEffect/useCallback
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
